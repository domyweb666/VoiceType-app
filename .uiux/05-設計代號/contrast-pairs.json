  "pairs": [
    {
      "fg": "文字-主",
      "bg": "底-群組",
      "where": "大標題、區段標題、首頁提示第一行"
    },
    {
      "fg": "文字-主",
      "bg": "底-列",
      "where": "列主文字、文字稿內文、面板訊息、狀態條的字"
    },
    {
      "fg": "文字-主",
      "bg": "底-凹槽",
      "where": "完成面板的文字稿預覽、分段控制沒選中的字"
    },
    {
      "fg": "文字-次",
      "bg": "底-列",
      "where": "列副標、日期、「潤飾模型」那行"
    },
    {
      "fg": "文字-次",
      "bg": "底-群組",
      "where": "區段標題與下方說明、首頁提示第二行"
    },
    {
      "fg": "文字-次",
      "bg": "底-凹槽",
      "where": "搜尋框 placeholder"
    },
    {
      "fg": "強調-可點",
      "bg": "底-列",
      "where": "「儲存並驗證」「復原」「再試一次」、工具列三顆、開關開著的底"
    },
    {
      "fg": "強調-可點",
      "bg": "底-群組",
      "where": "返回鈕、「去申請金鑰」、空清單「回首頁」、面板文字鈕"
    },
    {
      "fg": "強調-可點",
      "bg": "底-凹槽",
      "where": "面板圖示圓裡的金色圖示（非文字，3:1）",
      "large": true
    },
    {
      "fg": "底-列",
      "bg": "強調-可點",
      "where": "開關的白圓點、狀態條勾勾裡的白勾（非文字，3:1）",
      "large": true
    },
    {
      "fg": "動作-字玉米",
      "bg": "動作-底玉米",
      "where": "主要按鈕的字、錄音鈕的麥克風"
    },
    {
      "fg": "警示-文字",
      "bg": "底-列",
      "where": "「刪除金鑰」、待轉錄被拒那行紅字、失敗圖示"
    },
    {
      "fg": "警示-文字",
      "bg": "底-群組",
      "where": "錯誤區塊說明、刪不掉那一句"
    },
    {
      "fg": "錄音-字圖形",
      "bg": "錄音-紅底",
      "where": "停止鈕的方形圖形（非文字，3:1）",
      "large": true
    },
    {
      "fg": "波形-玉米",
      "bg": "底-列",
      "where": "錄音面板波形（面板底是白卡；非文字，3:1）",
      "large": true
    },
    {
      "fg": "方塊-收成字",
      "bg": "方塊-收成底最淺",
      "where": "穀倉方塊（第二批；漸層最淺端）"
    },
    {
      "fg": "方塊-收成字",
      "bg": "方塊-收成底最深",
      "where": "穀倉方塊（第二批；漸層最深端）"
    },
    {
      "fg": "方塊-待轉字-墨",
